@model CSCNotes.Models.NotesModel

<h2>Edit Note</h2>

<form method="post" class="mt-4">
    <input type="hidden" asp-for="UID" />

    <!-- Title -->
    <div class="mb-3">
        <label asp-for="Notes_Title" class="form-label fw-bold">Title</label>
        <input asp-for="Notes_Title" class="form-control" />
    </div>

    <!-- Content -->
    <div class="mb-3">
        <label asp-for="Notes_Content" class="form-label fw-bold">Content</label>
        <textarea asp-for="Notes_Content" class="form-control" rows="10" style="min-height: 250px;"></textarea>
    </div>

    <!-- Importance ENUM Dropdown -->
    <div class="mb-3">
        <label asp-for="_Importance" class="form-label fw-bold">Importance</label>
        <select asp-for="_Importance" class="form-select">
            <option value="@CSCNotes.Models.NotesModel.Importance.low">Low</option>
            <option value="@CSCNotes.Models.NotesModel.Importance.Med">Medium</option>
            <option value="@CSCNotes.Models.NotesModel.Importance.High">High</option>
        </select>
    </div>

    <button class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>