@model CSCNotes.Models.NotesModel

<h2>Create Note</h2>

<form method="post">

    <div class="mb-3">
        <label class="form-label fw-bold">Title</label>
        <input asp-for="Notes_Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Content</label>
        <textarea asp-for="Notes_Content" class="form-control" rows="6"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Importance</label>
        <select asp-for="_Importance" asp-items="Html.GetEnumSelectList<CSCNotes.Models.NotesModel.Importance>()"
            class="form-select">
        </select>
    </div>

    <button class="btn btn-primary mt-3">Create</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>